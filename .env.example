# =============================================================================
# engrix-router -- example environment file
#
# Operator notes:
#   Copy to `.env` at the repository root. `.env` is gitignored and read
#   automatically at startup via python-dotenv (core/config.py). Every value
#   below is the real default, commented out so you only uncomment what you
#   want to change.
#   Never put real secrets in this example file -- the <> placeholders are not
#   valid values, they are fill-in slots.
#
# Prefix: EROUTER_ = Engrix + Router. It is public API and stays stable.
# Boundary: env = things that need a restart (paths, bind, secrets, size caps,
# process deadlines). Anything changeable without a restart (routing strategy,
# budgets, retention) lives in the `settings` table -- dashboard or
# PATCH /api/settings, NOT here. One value lives in one place, never both.
# =============================================================================

# ── paths ────────────────────────────────────────────────────────────────────
# Defaults are relative to the repository root; everything the process writes
# lands under these directories.
# EROUTER_DATA_DIR=./data
#   default: <repo>/data  -- database, logs and verification artefacts
# EROUTER_DB_PATH=./data/engrix_router.sqlite3
#   default: <EROUTER_DATA_DIR>/engrix_router.sqlite3  -- SQLite + WAL; this file
#   holds the upstream tokens (cred_json column), so its permissions matter
# EROUTER_LOG_DIR=./data/logs
#   default: <EROUTER_DATA_DIR>/logs
# EROUTER_CREDENTIALS_DIR=./credentials
#   default: <repo>/credentials  -- gitignored; where a private adapter's credential
#   file lives. Not a gateway secret store, and never committed.

# ── server ───────────────────────────────────────────────────────────────────
# Bind loopback by default. This gateway holds upstream tokens and can spend
# quota, so do not set 0.0.0.0 unless you know why (see deploy/ for the one
# place where 0.0.0.0 is acceptable: behind a reverse proxy / private network).
# EROUTER_HOST=127.0.0.1
# EROUTER_PORT=8450
# Comma-separated origins. CORS middleware is only added when this is non-empty.
# EROUTER_CORS_ORIGINS=

# ── auth ─────────────────────────────────────────────────────────────────────
# REQUIRED for the admin API (/api/*). Empty = fail-closed: every /api/* route
# answers 503 "Admin API locked", there is deliberately no hardcoded default.
# Generate your own; the dashboard asks for this same token once.
# EROUTER_ADMIN_TOKEN=<token admin>
# Gate for /v1/*: does a client need a gateway API key (created via /api/keys)?
# true is the default and the safe answer even on loopback.
# EROUTER_REQUIRE_CLIENT_KEY=true

# ── body limits ──────────────────────────────────────────────────────────────
# Rejected before parsing, so an oversized payload cannot cost a vendor call.
# EROUTER_MAX_REQUEST_BYTES=6291456
#   default: 6 MiB
# Per-stage trace payload cap, in bytes; bigger payloads are stored truncated
# with an explicit `truncated` + `original_bytes` marker.
# EROUTER_MAX_STAGE_BYTES=65536
#   default: 64 KiB

# ── upstream deadlines (seconds) ─────────────────────────────────────────────
# The gateway cuts a call off BEFORE the client's own deadline, otherwise the
# client retries while the vendor is still thinking = double upstream spend.
# EROUTER_UPSTREAM_CONNECT_TIMEOUT_S=20.0
# EROUTER_UPSTREAM_FIRST_CHUNK_TIMEOUT_S=25.0
#   time-to-first-token; keep it below the client's round timeout
# EROUTER_UPSTREAM_STALL_TIMEOUT_S=120.0
#   watchdog between SSE chunks
# EROUTER_UPSTREAM_TOTAL_TIMEOUT_S=300.0
#   hard cap for one attempt, and the budget for the whole failover loop

# ── logging ──────────────────────────────────────────────────────────────────
# EROUTER_LOG_LEVEL=info
# EROUTER_LOG_RING_SIZE=2000
#   in-memory ring buffer served by /api/logs
# EROUTER_LOG_FILE=true
#   rotating file sink in EROUTER_LOG_DIR
# EROUTER_LOG_FILE_MAX_BYTES=5242880
# EROUTER_LOG_FILE_BACKUPS=3
# Headers redacted on every log and trace path. Comma-separated; the default
# covers the standard auth/cookie headers. Adapters that impersonate client
# identity headers add their own names here. Only add names.
# EROUTER_REDACT_HEADERS=authorization,x-api-key,x-goog-api-key,cookie,set-cookie,x-gw-user-id

# ── mode ─────────────────────────────────────────────────────────────────────
# EROUTER_DRY_RUN=false
#   true = the full pipeline runs (resolve, admission, routing, build_request,
#   trace) but the upstream is never called; the response is a synthetic
#   `stop` chunk with `engrix_dry_run: true`. Use it to diff payloads without
#   burning credits.
# EROUTER_TEST_MODE=false
#   read by tests/ only; not a production knob

# ── provider discovery (ADR-0002) ────────────────────────────────────────────
# Development override so a provider shipped outside this repository (a private
# adapter distribution) runs straight from a checkout, no wheel built. Path list
# separated by os.pathsep -- ';' on Windows, ':' on POSIX. Each entry may hold flat
# provider modules (<dir>/myvendor.py) or provider packages (<dir>/myvendor/__init__.py).
# Providers installed as distributions do NOT need this: they attach through the
# `engrix_router.providers` entry-point group. A listed directory that does not exist is
# not fatal: it is reported per source in /health under `providers_failed`.
# Dev example (sibling checkout, no install step):
# EROUTER_PROVIDERS_PATH=../my-providers/src/my_providers

# ── proxy pool ───────────────────────────────────────────────────────────────
# Probe target for `POST /api/proxy-pools/{id}/test` (cheap, no tokens).
# EROUTER_PROXY_TEST_URL=https://example.com/
#
# EROUTER_PROXY_<NAME> IS A TEMPLATE, NOT A LITERAL VARIABLE.
# One env var per proxy credential, named whatever you like. The proxy_pools
# row stores only the name in its `credential_hint` column, never the secret,
# and proxy_url must not contain userinfo. Example (NOT a supported name):
#   EROUTER_PROXY_POOL_A=<user:pass>
# Missing hint = the pool runs without a proxy, unless strict_proxy is set,
# in which case the request fails instead of silently going direct.
